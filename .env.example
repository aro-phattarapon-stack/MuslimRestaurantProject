CLOUD_LLM_API_KEY=
CLOUD_LLM_MODEL=openai/gpt-4.1-mini

# Use the same Google OAuth Web client ID in both variables.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Required for Google sign-in and OTP verification.
DATABASE_URL=postgresql://username:password@localhost:5432/halal_chiang_rai
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

# Local OTP testing: run Mailpit and use http://localhost:8025 to view emails.
EMAIL_PROVIDER=mailpit
MAILPIT_HOST=127.0.0.1
MAILPIT_PORT=1025
MAIL_FROM_EMAIL=Halal Chiang Rai <otp@example.test>

# Use these instead when sending real emails through Resend.
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=Halal Chiang Rai <auth@your-verified-domain.com>
